name = "balatro-sync"
main = "src/index.js"
compatibility_date = "2024-09-01"
workers_dev = true

# Custom Domain (Optional: route your own domain/subdomain to this Worker)
# routes = [
#   { pattern = "balatro.yourdomain.com", custom_domain = true }
# ]

[vars]
AUTH_TOKEN = "your_secret_auth_token_here"

# Persistent SQLite database via Cloudflare D1
# Create with: npx wrangler d1 create balatro-db
# Apply schema: npx wrangler d1 execute balatro-db --remote --file=./schema.sql
#
# [[d1_databases]]
# binding = "balatro_db"
# database_name = "balatro-db"
# database_id = "your-d1-database-id"
